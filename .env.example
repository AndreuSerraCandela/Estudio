# SQL Server
DB_SERVER=localhost
ESTUDIO_DB_NAME=Estudio
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=0
# En IIS/producción, si la BD ya existe, pon 0 para no intentar CREATE DATABASE
# ESTUDIO_AUTO_CREATE_DB=0
# Si la BD ya está creada y migrada, puedes omitir init_db al arrancar:
# ESTUDIO_INIT_DB=0

# Esquema SQL (por defecto usa sql/estudio_schema.sql dentro del proyecto)
# ESTUDIO_SCHEMA_PATH=C:\inetpub\wwwroot\Estudio\sql\estudio_schema.sql

# Logo corporativo (por defecto app/static/images/logomalla.png)
# CORPORATIVO_LOGO_PATH=C:\inetpub\wwwroot\Estudio\app\static\images\logomalla.png

# Repositorio de documentos (base64-api)
STRAPI_URL=https://base64-api.deploy.malla.es
DOCUMENT_VIEWER_URL=https://documentos.malla.es

# Correo comun para todos los usuarios. Cada usuario solo guarda su email y password.
# ESTUDIO_IMAP_HOST=outlook.office365.com
# ESTUDIO_IMAP_PORT=993
# ESTUDIO_IMAP_USE_SSL=1
# ESTUDIO_IMAP_INBOX=INBOX
# ESTUDIO_IMAP_SENT=Sent Items
# ESTUDIO_SMTP_HOST=smtp.office365.com
# ESTUDIO_SMTP_PORT=587
# ESTUDIO_SMTP_USE_TLS=1
# ESTUDIO_SMTP_USE_SSL=0

# Business Central (OData) — obligatorio en servidor si no hay carpeta Incidencias
BC_BASE_URL=https://bc220.malla.es
BC_COMPANY=Malla Publicidad
BC_USERNAME=
BC_PASSWORD=
BC_TIMEOUT=60

# --- Desarrollo local ---
HOST=127.0.0.1
PORT=8000
FLASK_DEBUG=1

# --- IIS / produccion (patron Rutas: C:\Python\python.exe + install_iis.bat) ---
# FLASK_DEBUG=0
# ESTUDIO_BEHIND_HTTPS=1
# ESTUDIO_AUTO_CREATE_DB=0
# ESTUDIO_INIT_DB=1

# Obligatorio en servidor IIS
SECRET_KEY=cambia-esto-en-produccion

# Base de datos de usuarios (Control de Presencia). Si comparte servidor SQL con Estudio,
# puedes omitir PRESENCIA_DB_* y definir PRESENCIA_ENV_FILE apuntando al .env de Presencia:
# PRESENCIA_ENV_FILE=C:\inetpub\wwwroot\ControlPresencia\.env
PRESENCIA_DB_SERVER=localhost
# Nombre exacto en SQL Server (sin "de"): ControlPresencia
PRESENCIA_DB_NAME=ControlPresencia
PRESENCIA_DB_USER=
PRESENCIA_DB_PASSWORD=
# PRESENCIA_DB_TRUSTED_CONNECTION=0

# Rutas opcionales de otros proyectos (solo desarrollo local)
# OBJETOS_DIR=C:\Users\Andres\Source\Python\Objetos
# INCIDENCIAS_DIR=C:\Users\Andres\Source\Python\Incidencias
# PRESENCIA_DIR=C:\Users\Andres\Source\Python\ControldePresencia
