# SQL Server (misma conexión que Objetos en C:\Users\Andres\Source\Python\Objetos)
# Si no defines estas variables aquí, se reutilizan las de Objetos\.env
DB_SERVER=localhost
ESTUDIO_DB_NAME=Estudio
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=0

# Ruta al esquema SQL (por defecto: Objetos\sql\estudio_schema.sql)
# ESTUDIO_SCHEMA_PATH=C:\Users\Andres\Source\Python\Objetos\sql\estudio_schema.sql

# Repositorio de documentos (base64-api, mismo servicio que Incidencias)
# POST {STRAPI_URL}/save   DELETE {STRAPI_URL}/delete
STRAPI_URL=https://base64-api.deploy.malla.es

# Business Central (OData). Si no se definen, se reutilizan credenciales de Incidencias\config.py
BC_BASE_URL=https://bc220.malla.es
BC_COMPANY=Malla Publicidad
BC_USERNAME=
BC_PASSWORD=
BC_TIMEOUT=60

# Servidor Flask
HOST=127.0.0.1
PORT=8000
FLASK_DEBUG=1
# Mismo SECRET_KEY que ControldePresencia (si no se define, se lee de su .env)
# SECRET_KEY=

# Base de datos de usuarios (Control de Presencia)
# PRESENCIA_DB_NAME=ControldePresencia
